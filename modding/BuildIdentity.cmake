file(GLOB_RECURSE inputs "${ROOT}/src/*.cpp" "${ROOT}/src/*.h" "${ROOT}/src/*.ld"
    "${ROOT}/modding/runtime/*.cpp" "${ROOT}/modding/runtime/*.h" "${ROOT}/modding/sdk/*.h")
list(APPEND inputs "${ROOT}/CMakeLists.txt" "${ROOT}/modding/CMakeLists.txt" "${ROOT}/modding/BuildIdentity.cmake")
list(SORT inputs)
file(READ "${CACHE}" settings)
set(identity "linux-i386;${settings}")
file(SHA256 "${COMPILER}" compiler_hash)
string(APPEND identity "${compiler_hash}")
foreach(input IN LISTS inputs)
    file(SHA256 "${input}" fingerprint)
    file(RELATIVE_PATH relative "${ROOT}" "${input}")
    string(APPEND identity "${relative}:${fingerprint}\n")
endforeach()
string(SHA256 fingerprint "${identity}")
set(content "#define UG2_MOD_BUILD_ID \"${fingerprint}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT content STREQUAL previous)
    file(WRITE "${OUTPUT}" "${content}")
endif()
